{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|WebFetch)$|__start_process$|__device_bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/agent-pii-egress-guard/guard.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
